{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Electron Benchmarks configuration",
  "type": "object",
  "additionalProperties": false,
  "required": ["test", "electrons"],
  "properties": {
    "test": { "enum": ["startup", "memory", "cpu", "all"] },
    "electrons": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
    "scenario": { "enum": ["warm", "cold"] },
    "repeat": { "type": "integer", "minimum": 1, "maximum": 10000 },
    "out": { "type": "string", "minLength": 1 }
  },
  "if": { "required": ["scenario"] },
  "then": { "properties": { "test": { "const": "startup" } } }
}
