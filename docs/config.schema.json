{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "electron-benchmarks 0.2.3 configuration",
  "oneOf": [
    {
      "$ref": "#/$defs/job"
    },
    {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "jobs"
      ],
      "properties": {
        "jobs": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/job"
          }
        }
      }
    }
  ],
  "$defs": {
    "job": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "test",
        "electrons"
      ],
      "properties": {
        "test": {
          "enum": [
            "startup",
            "startup:warm",
            "startup:cold",
            "startup:all",
            "all",
            "memory",
            "memory:idle",
            "cpu",
            "cpu:idle"
          ]
        },
        "electrons": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "repeat": {
          "type": "integer",
          "minimum": 1,
          "maximum": 10000
        },
        "deployTo": {
          "type": "string",
          "minLength": 1
        },
        "out": {
          "type": "string",
          "minLength": 1
        }
      }
    }
  }
}
