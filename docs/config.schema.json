{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "electron-benchmarks 0.1.0 configuration",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "test",
    "electrons"
  ],
  "properties": {
    "test": {
      "enum": [
        "startup",
        "startup:warm",
        "memory",
        "cpu"
      ]
    },
    "electrons": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "repeat": {
      "type": "integer",
      "minimum": 1,
      "maximum": 10000
    },
    "out": {
      "type": "string",
      "minLength": 1
    }
  }
}
