{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Electron Benchmarks output v2",
  "description": "stdout and summary.json. Paths are absolute on the measurement host. Ignore unknown fields when consuming compatible additive changes; reject unsupported schema versions.",
  "oneOf": [
    {
      "$ref": "#/$defs/result"
    },
    {
      "$ref": "#/$defs/error"
    }
  ],
  "$defs": {
    "result": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schemaVersion",
        "kind",
        "toolVersion",
        "sceneVersion",
        "status",
        "outputDirectory",
        "baselineTarget",
        "dataComplete",
        "completed",
        "planned",
        "valid",
        "failed",
        "unexecuted",
        "error",
        "cleanupError",
        "targets",
        "groups",
        "metricDefinitions",
        "warnings",
        "statistics",
        "artifacts"
      ],
      "properties": {
        "schemaVersion": {
          "const": 2
        },
        "kind": {
          "const": "result"
        },
        "toolVersion": {
          "type": "string"
        },
        "sceneVersion": {
          "type": "string"
        },
        "status": {
          "enum": [
            "prepared",
            "running",
            "waiting-reboot",
            "complete",
            "failed",
            "interrupted"
          ]
        },
        "outputDirectory": {
          "type": "string"
        },
        "baselineTarget": {
          "type": "string"
        },
        "dataComplete": {
          "type": "boolean"
        },
        "completed": {
          "type": "integer",
          "minimum": 0
        },
        "planned": {
          "type": "integer",
          "minimum": 0
        },
        "valid": {
          "type": "integer",
          "minimum": 0
        },
        "failed": {
          "type": "integer",
          "minimum": 0
        },
        "unexecuted": {
          "type": "integer",
          "minimum": 0
        },
        "error": {
          "anyOf": [
            {
              "type": "null"
            },
            {
              "$ref": "#/$defs/failure"
            }
          ]
        },
        "cleanupError": {
          "anyOf": [
            {
              "type": "null"
            },
            {
              "$ref": "#/$defs/failure"
            }
          ]
        },
        "targets": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "id",
              "input",
              "version",
              "identity"
            ],
            "properties": {
              "id": {
                "type": "string"
              },
              "input": {
                "type": "string"
              },
              "version": {
                "type": "string"
              },
              "identity": {
                "type": "string"
              }
            }
          }
        },
        "groups": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/group"
          }
        },
        "metricDefinitions": {
          "type": "object",
          "propertyNames": {
            "enum": [
              "appReadyMs",
              "videoCallbackMs",
              "parentToCreationMs",
              "spawnCallMs",
              "privateBytesSumMiB",
              "workingSetSumMiB",
              "observedWorkingSetPeakMiB",
              "cpuPercentMachine",
              "cpuTimeSeconds"
            ]
          },
          "additionalProperties": {
            "$ref": "#/$defs/definition"
          }
        },
        "warnings": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/warning"
          }
        },
        "statistics": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "primary",
            "secondary",
            "comparison",
            "quantileMethod",
            "warmupsExcluded",
            "failedExcluded",
            "difference",
            "zeroBaselinePercent"
          ],
          "properties": {
            "primary": {
              "const": "p50"
            },
            "secondary": {
              "const": "p90"
            },
            "comparison": {
              "const": "p50"
            },
            "quantileMethod": {
              "const": "linear-interpolation"
            },
            "warmupsExcluded": {
              "const": true
            },
            "failedExcluded": {
              "const": true
            },
            "difference": {
              "const": "target-minus-baseline"
            },
            "zeroBaselinePercent": {
              "type": "null"
            }
          }
        },
        "artifacts": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "summary",
            "environment",
            "samples",
            "plan",
            "run"
          ],
          "properties": {
            "summary": {
              "type": "string"
            },
            "environment": {
              "type": "string"
            },
            "samples": {
              "type": "string"
            },
            "plan": {
              "type": [
                "string",
                "null"
              ]
            },
            "run": {
              "type": [
                "string",
                "null"
              ]
            }
          }
        }
      }
    },
    "error": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schemaVersion",
        "kind",
        "status",
        "error"
      ],
      "properties": {
        "schemaVersion": {
          "const": 2
        },
        "kind": {
          "const": "error"
        },
        "status": {
          "enum": [
            "failed",
            "interrupted"
          ]
        },
        "error": {
          "$ref": "#/$defs/failure"
        }
      }
    },
    "failure": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "code",
        "stage",
        "message"
      ],
      "properties": {
        "code": {
          "type": "string"
        },
        "stage": {
          "enum": [
            "input",
            "environment",
            "prepare",
            "consent",
            "measurement",
            "cleanup",
            "output"
          ]
        },
        "message": {
          "type": "string"
        }
      }
    },
    "metric": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "p50",
        "p90"
      ],
      "properties": {
        "p50": {
          "type": "number"
        },
        "p90": {
          "type": "number"
        },
        "difference": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "absolute",
            "percent"
          ],
          "properties": {
            "absolute": {
              "type": "number"
            },
            "percent": {
              "type": [
                "number",
                "null"
              ]
            }
          }
        }
      }
    },
    "group": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "target",
        "phase",
        "planned",
        "valid",
        "failed",
        "unexecuted",
        "missingMetrics",
        "metrics"
      ],
      "properties": {
        "target": {
          "type": "string"
        },
        "phase": {
          "enum": [
            "cold",
            "warm",
            "memory",
            "cpu"
          ]
        },
        "planned": {
          "type": "integer",
          "minimum": 0
        },
        "valid": {
          "type": "integer",
          "minimum": 0
        },
        "failed": {
          "type": "integer",
          "minimum": 0
        },
        "unexecuted": {
          "type": "integer",
          "minimum": 0
        },
        "missingMetrics": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "enum": [
              "appReadyMs",
              "videoCallbackMs",
              "parentToCreationMs",
              "spawnCallMs",
              "privateBytesSumMiB",
              "workingSetSumMiB",
              "observedWorkingSetPeakMiB",
              "cpuPercentMachine",
              "cpuTimeSeconds"
            ]
          }
        },
        "metrics": {
          "type": "object",
          "propertyNames": {
            "enum": [
              "appReadyMs",
              "videoCallbackMs",
              "parentToCreationMs",
              "spawnCallMs",
              "privateBytesSumMiB",
              "workingSetSumMiB",
              "observedWorkingSetPeakMiB",
              "cpuPercentMachine",
              "cpuTimeSeconds"
            ]
          },
          "additionalProperties": {
            "$ref": "#/$defs/metric"
          }
        }
      }
    },
    "warning": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "code",
        "message"
      ],
      "properties": {
        "code": {
          "type": "string"
        },
        "message": {
          "type": "string"
        },
        "target": {
          "type": "string"
        },
        "phase": {
          "enum": [
            "cold",
            "warm",
            "memory",
            "cpu"
          ]
        }
      }
    },
    "definition": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "unit",
        "direction",
        "role",
        "description"
      ],
      "properties": {
        "unit": {
          "enum": [
            "ms",
            "MiB",
            "%",
            "s"
          ]
        },
        "direction": {
          "enum": [
            "lower",
            "informational"
          ]
        },
        "role": {
          "enum": [
            "primary",
            "secondary",
            "diagnostic"
          ]
        },
        "description": {
          "type": "string"
        }
      }
    }
  }
}
